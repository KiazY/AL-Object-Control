{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "object-control.json",
    "title": "Object Control Setup",
    "type": "object",
    "properties": {
        "tenantId": {
            "description": "ID of the Sharepoint tenant",
            "type": "string"
        },
        "clientId": {
            "description": "Azure App Registration's Client ID",
            "type": "string"
        },
        "sharepointSiteUrl": {
            "description": "Full URL of the SharePoint site used to store the AL Object Control List. e.g: https://contoso.sharepoint.com/sites/MySite or https://contoso.sharepoint.com/teams/MyTeam",
            "type": "string"
        },
        "sharepointListName": {
            "description": "Name of the SharePoint list used to store the AL Object Control List. e.g: ALObjectControlList",
            "type": "string"
        },
        "range": {
            "description": "Range of the Object IDs to suggest",
            "type": "object",
            "properties": {
                "from": {
                    "description": "From Object ID..",
                    "type": "integer"
                },
                "to": {
                    "description": "..To Object ID",
                    "type": "integer"
                }
            }
        }
    }
}